<div class="layout">
  <!--      OG      -->
  <div class="lg:hidden">
    {% if image_quadrant %}
      <img class="image image--contain image-dither w--[95cqw]" src="{{ image_quadrant }}" alt="{{ air_quality_title }}">
    {% endif %}
  </div>
  <!--      X : ne pas modifier      -->
  <div class="hidden lg:block w--full h--full">
    {% if graph_quadrant_x %}
      <img class="image image--contain image-dither" src="{{ graph_quadrant_x }}" alt="{{ air_quality_title }}">
    {% endif %}
  </div>
</div>
<div class="title_bar">
  <span class="title">
    {{ pair_graph_1_key | upcase }}
    
    (µg/m³)
    
  </span>
  <span class="instance">
    {{ station }}
  </span>
</div>