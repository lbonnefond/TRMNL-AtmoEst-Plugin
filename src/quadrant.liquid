<div class="layout">

  <!-- OG -->
  <div class="lg:hidden w--full h--full">
    {% if image_quadrant %}
      <img
        class="image image--contain image-dither"
        src="{{ image_quadrant }}"
        alt="{{ air_quality_title }}">
    {% endif %}
  </div>

  <!-- X -->
  <div class="hidden lg:block w--full h--full">
    {% if graph_quadrant_x %}
      <img
        class="image image--contain image-dither"
        src="{{ graph_quadrant_x }}"
        alt="{{ air_quality_title }}">
    {% endif %}
  </div>

</div>

<div class="title_bar">
  <span class="title">
    24h Atmo Grand Est
  </span>
  <span class="instance">
    {{ station }}
  </span>
</div>