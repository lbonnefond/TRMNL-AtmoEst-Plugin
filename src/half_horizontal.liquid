<div class="layout">

  <!-- OG -->
  <div class="grid grid--cols-2 gap--small pb--small mt--3 lg:hidden">
    {% if pair_graph_1_image %}
      <img
        class="image image--contain image-dither"
        src="{{ pair_graph_1_image }}"
        alt="{{ pair_graph_1_title }}">
    {% endif %}
    {% if pair_graph_2_image %}
      <img
        class="image image--contain image-dither"
        src="{{ pair_graph_2_image }}"
        alt="{{ pair_graph_2_title }}">
    {% endif %}
  </div>

  <!-- X landscape -->
  <div class="hidden lg:grid lg:grid--cols-2 lg:gap--small lg:portrait:hidden">
    {% if pair_graph_1_image_x %}
      <img
        class="image image--contain image-dither"
        src="{{ pair_graph_1_image_x }}"
        alt="{{ pair_graph_1_title }}">
    {% endif %}
    {% if pair_graph_2_image_x %}
      <img
        class="image image--contain image-dither"
        src="{{ pair_graph_2_image_x }}"
        alt="{{ pair_graph_2_title }}">
    {% endif %}
  </div>

</div>

<div class="title_bar">
  <span class="title">
    24h Atmo Grand Est · {{ pair_graph_1_title }} / {{ pair_graph_2_title }}
  </span>
  <span class="instance">
    {{ station }}
  </span>
</div>