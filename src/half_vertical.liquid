<div class="layout">
  <div class="flex flex--col gap--small pb--small mt--3">

    {% if pair_graph_1_image %}
      <img
        class="image image--contain image-dither"
        src="{{ pair_graph_1_image }}"
        alt="{{ pair_graph_1_title }}">
    {% endif %}

    {% if pair_graph_2_image %}
      <img
        class="image image--contain image-dither"
        src="{{ pair_graph_2_image }}"
        alt="{{ pair_graph_2_title }}">
    {% endif %}

  </div>
</div>

<div class="title_bar">
  <span class="title">
    {{ pair_graph_1_title }} / {{ pair_graph_2_title }}
  </span>
  <span class="instance">
    {{ station }}
  </span>
</div>