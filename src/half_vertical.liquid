<div class="layout">
  <!--            OG            -->
  <div class="flex flex--col gap--small pb--small mt--3 lg:hidden">
    {% if pair_graph_1_image %}
      <img class="image image--contain image-dither" src="{{ pair_graph_1_image }}" alt="{{ pair_graph_1_title }}">
    {% endif %}
    {% if pair_graph_2_image %}
      <img class="image image--contain image-dither" src="{{ pair_graph_2_image }}" alt="{{ pair_graph_2_title }}">
    {% endif %}
  </div>
  <!--        X        -->
  <div class="hidden lg:flex lg:flex--col lg:gap--small">
    {% if pair_graph_1_image_x_half_vertical %}
      <img class="image image--contain image-dither w--full" src="{{ pair_graph_1_image_x_half_vertical }}" alt="{{ pair_graph_1_title }}">
    {% endif %}
    {% if pair_graph_2_image_x_half_vertical %}
      <img class="image image--contain image-dither w--full" src="{{ pair_graph_2_image_x_half_vertical }}" alt="{{ pair_graph_2_title }}">
    {% endif %}
    <div class="hidden lg:portrait:flex flex--col h--full">
    {% if full_graph_3_image %}
      <img class="image image--contain image-dither w--full" src="{{ full_graph_3_image }}" alt="{{ pair_graph_2_title }}">
    {% endif %}
    {% if full_graph_4_image %}
      <img class="image image--contain image-dither w--full" src="{{ full_graph_4_image }}" alt="{{ pair_graph_2_title }}">
    {% endif %}
    </div>
  </div>
</div>
<div class="title_bar">
  <span class="title">
    {{ pair_graph_1_key | upcase }}
     / 
    {{ pair_graph_2_key | upcase }}
     (µg/m³)
  
  </span>
  <span class="instance">
    {{ station }}
  </span>
</div>